rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email == 'joshmukandirwa@gmail.com' && request.auth.token.email_verified == true)
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    // Maintenance : quand l'admin l'active (config/maintenance), plus personne d'autre que lui ne peut écrire.
    function siteOpen() {
      return !(exists(/databases/$(database)/documents/config/maintenance)
        && get(/databases/$(database)/documents/config/maintenance).data.on == true
        && get(/databases/$(database)/documents/config/maintenance).data.until > request.time);
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Un vendeur peut publier s'il n'est pas bloqué (l'email n'est plus exigé : chaque article est validé par l'admin) et son abonnement court encore.
    function canPost() {
      return signedIn() && siteOpen()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().status == 'active'
        && profile().activeUntil > request.time;
    }

    // Essai gratuit (plan 'essai') : 2 publications par jour. Les comptes sans champ 'plan' comptent comme essai.
    function isTrial() {
      return !('plan' in profile()) || profile().plan == 'essai';
    }
    // Jour en RDC (UTC+2), au format AAAAMMJJ
    function dayKey() {
      let t = request.time + duration.value(2, 'h');
      return string(t.year()) + (t.month() < 10 ? '0' : '') + string(t.month()) + (t.day() < 10 ? '0' : '') + string(t.day());
    }
    // En essai, une proposition doit porter l'identifiant uid_AAAAMMJJ_1 ou uid_AAAAMMJJ_2 : un identifiant ne sert qu'une fois, donc 2 par jour au maximum.
    function slotOk(id) {
      return !isTrial() || id == request.auth.uid + '_' + dayKey() + '_1' || id == request.auth.uid + '_' + dayKey() + '_2';
    }

    // Photos : uniquement des liens Cloudinary de SokoPlus (1 à 3)
    function imgUrl(u) { return u is string && u.size() <= 300 && u.matches('https://res[.]cloudinary[.]com/dqtu9carq/.*'); }
    function imgsOk(l) {
      return l is list && l.size() >= 1 && l.size() <= 3 && imgUrl(l[0])
        && (l.size() < 2 || imgUrl(l[1])) && (l.size() < 3 || imgUrl(l[2]));
    }
    // Proposition de modification d'un article existant : un seul identifiant possible par article (uid_edit_idArticle), et l'article doit être à soi
    function editOk(id) {
      let r = request.resource.data.replaces;
      return r is string && r.size() <= 60 && id == request.auth.uid + '_edit_' + r
        && exists(/databases/$(database)/documents/items/$(r))
        && get(/databases/$(database)/documents/items/$(r)).data.ownerId == request.auth.uid;
    }

    // Monnaies acceptées : celles des pays d'Afrique, le dollar et l'euro (FC = franc congolais)
    function currencies() {
      return ['USD', 'EUR', 'FC', 'RWF', 'BIF', 'UGX', 'KES', 'TZS', 'XAF', 'XOF', 'AOA', 'ZMW', 'ZWL', 'MZN', 'MWK', 'ZAR', 'NAD', 'BWP', 'SZL', 'LSL', 'MGA', 'MUR', 'SCR', 'KMF', 'ETB', 'ERN', 'DJF', 'SOS', 'SSP', 'SDG', 'EGP', 'LYD', 'TND', 'DZD', 'MAD', 'MRU', 'GMD', 'GNF', 'SLE', 'LRD', 'GHS', 'NGN', 'STN', 'CVE'];
    }
    function countryOk(d) { return !('country' in d) || (d.country is string && d.country.size() == 2); }
    // Promotion choisie par le vendeur : ancien prix (facultatif, plus haut que le prix) et type d'annonce (facultatif)
    function promoOk(d) {
      return (!('oldPrice' in d) || (d.oldPrice is number && d.oldPrice > d.price && d.oldPrice < 100000000))
        && (!('tag' in d) || d.tag in ['promo', 'offre']);
    }
    function isCertified() {
      return ('certified' in profile()) && profile().certified == true;
    }
    // Forme d'un article en ligne (admin, ou boutique certifiée qui publie directement)
    function itemShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'description', 'price', 'category', 'address', 'city', 'currency', 'images', 'ownerId', 'shopName', 'phone', 'shopLogo', 'shopPay', 'status', 'featured', 'createdAt', 'certified', 'oldPrice', 'tag', 'country'])
        && d.ownerId is string
        && d.status == 'available'
        && d.featured == false
        && d.createdAt == request.time
        && d.title is string && d.title.size() >= 2 && d.title.size() <= 100
        && d.description is string && d.description.size() <= 1500
        && d.price is number && d.price > 0 && d.price < 100000000
        && (!('city' in d) || (d.city is string && d.city.size() <= 40))
        && (!('shopPay' in d) || (d.shopPay is string && d.shopPay.size() <= 120))
        && (!('currency' in d) || d.currency in currencies())
        && promoOk(d) && countryOk(d)
        && imgsOk(d.images);
    }

    // Administrateurs : documents créés à la main dans la console (README, étape 7)
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // Compte acheteur : prénom affiché avec les avis. Chacun lit et modifie seulement le sien.
    match /buyers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && siteOpen() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && siteOpen() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40;
      allow delete: if isAdmin();
    }

    // Avis clients : un par personne et par article (identifiant = uid_article). Visibles seulement après validation par l'admin.
    function reviewShape(d) {
      return d.keys().hasOnly(['itemId', 'shopId', 'buyerId', 'buyerName', 'buyerLogo', 'stars', 'text', 'status', 'createdAt'])
        && (!('buyerLogo' in d) || (d.buyerLogo is string && d.buyerLogo.size() <= 300 && d.buyerLogo.matches('https://.*')))
        && d.itemId is string && d.stars is int && d.stars >= 1 && d.stars <= 5
        && d.text is string && d.text.size() <= 300
        && d.buyerName is string && d.buyerName.size() >= 2 && d.buyerName.size() <= 40
        && d.status == 'pending';
    }
    match /reviews/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin() || (signedIn() && resource.data.buyerId == request.auth.uid);
      allow create: if signedIn() && siteOpen() && reviewShape(request.resource.data)
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.shopId is string && request.resource.data.shopId != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.itemId
        && exists(/databases/$(database)/documents/items/$(request.resource.data.itemId))
        && get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.ownerId == request.resource.data.shopId
        && exists(/databases/$(database)/documents/buyers/$(request.auth.uid))
        && get(/databases/$(database)/documents/buyers/$(request.auth.uid)).data.name == request.resource.data.buyerName
        && request.resource.data.createdAt == request.time;
      // l'acheteur peut modifier son avis : il repasse en « à valider »
      allow update: if isAdmin()
        || (signedIn() && siteOpen() && resource.data.buyerId == request.auth.uid && reviewShape(request.resource.data)
            && request.resource.data.buyerId == resource.data.buyerId && request.resource.data.shopId == resource.data.shopId && request.resource.data.itemId == resource.data.itemId
            && request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isAdmin() || (signedIn() && resource.data.buyerId == request.auth.uid);
    }

    // « Avis utile » : un vote par personne et par avis (identifiant = uid_avis). Lisibles par tous pour afficher le total ; chacun ne retire que le sien.
    match /reviewVotes/{id} {
      allow read: if true;
      allow create: if signedIn() && siteOpen()
        && request.resource.data.keys().hasOnly(['reviewId', 'shopId', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reviewId is string && request.resource.data.shopId is string
        && id == request.auth.uid + '_' + request.resource.data.reviewId
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/reviews/$(request.resource.data.reviewId))
        && get(/databases/$(database)/documents/reviews/$(request.resource.data.reviewId)).data.status == 'approved'
        && get(/databases/$(database)/documents/reviews/$(request.resource.data.reviewId)).data.shopId == request.resource.data.shopId
        && get(/databases/$(database)/documents/reviews/$(request.resource.data.reviewId)).data.buyerId != request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Profil vendeur
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && siteOpen() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['shopName', 'phone', 'email', 'status', 'plan', 'activeUntil', 'createdAt'])
        && request.resource.data.shopName is string
        && request.resource.data.shopName.size() >= 2 && request.resource.data.shopName.size() <= 60
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10 && request.resource.data.phone.size() <= 15
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'active'
        && request.resource.data.plan == 'essai'
        && request.resource.data.createdAt == request.time
        // essai gratuit : environ 30 jours, pas plus
        && request.resource.data.activeUntil > request.time + duration.value(28, 'd')
        && request.resource.data.activeUntil < request.time + duration.value(32, 'd');
      // Nom, numéro, photo de profil et modes de paiement : le vendeur les modifie lui-même, sans validation de l'admin
      allow update: if isAdmin()
        || (signedIn() && siteOpen() && request.auth.uid == uid
            && resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shopName', 'phone', 'logo', 'payments'])
            && request.resource.data.shopName is string
            && request.resource.data.shopName.size() >= 2 && request.resource.data.shopName.size() <= 60
            && request.resource.data.phone is string
            && request.resource.data.phone.size() >= 10 && request.resource.data.phone.size() <= 15
            && (!('logo' in request.resource.data) || imgUrl(request.resource.data.logo))
            && (!('payments' in request.resource.data) || (request.resource.data.payments is string && request.resource.data.payments.size() <= 120)));
    }

    // Profil public de la boutique (couverture, à propos, coordonnées, liens) : lisible par tous, modifié par le vendeur lui-même, sans validation
    function linkOk(u) { return u is string && u.size() <= 200 && u.matches('https?://.*'); }
    match /shops/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && siteOpen() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().status == 'active'
        && request.resource.data.keys().hasOnly(['cover', 'about', 'address', 'email', 'website', 'facebook', 'instagram', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (!('cover' in request.resource.data) || imgUrl(request.resource.data.cover))
        && (!('about' in request.resource.data) || (request.resource.data.about is string && request.resource.data.about.size() <= 300))
        && (!('address' in request.resource.data) || (request.resource.data.address is string && request.resource.data.address.size() <= 150))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 100 && request.resource.data.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')))
        && (!('website' in request.resource.data) || linkOk(request.resource.data.website))
        && (!('facebook' in request.resource.data) || linkOk(request.resource.data.facebook))
        && (!('instagram' in request.resource.data) || linkOk(request.resource.data.instagram));
      allow delete: if isAdmin();
    }

    // Demandes de modification de boutique (nom, numéro, photo de profil) : une par boutique, validée ou refusée par l'admin
    match /profileRequests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && siteOpen() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['shopName', 'phone', 'logo', 'payments', 'status', 'createdAt'])
        && request.resource.data.keys().hasAny(['shopName', 'phone', 'logo', 'payments'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && (!('shopName' in request.resource.data) || (request.resource.data.shopName is string && request.resource.data.shopName.size() >= 2 && request.resource.data.shopName.size() <= 60))
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() >= 10 && request.resource.data.phone.size() <= 15))
        && (!('payments' in request.resource.data) || (request.resource.data.payments is string && request.resource.data.payments.size() <= 120))
        && (!('logo' in request.resource.data) || (request.resource.data.logo is string && request.resource.data.logo.matches('https://.*') && request.resource.data.logo.size() <= 300));
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid && resource.data.status == 'rejected');
    }

    // Demandes de certification : une par boutique. Le vendeur la crée (en attente), l'admin l'approuve (la demande disparaît) ou la refuse (avec motif)
    match /certRequests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && siteOpen() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('certified', false) != true
        && request.resource.data.keys().hasOnly(['status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid && resource.data.status == 'rejected');
    }

    // Messages de SokoPlus à un vendeur (certification approuvée ou refusée...). Écrits par l'admin ; le vendeur les lit et les marque comme lus.
    match /userNotifs/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin();
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Numéro -> email, pour se connecter avec le téléphone (lecture d'un seul document à la fois, pas de liste)
    match /phoneIndex/{phone} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && (siteOpen() || isAdmin())
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && ((request.resource.data.uid == request.auth.uid && request.resource.data.email == request.auth.token.email
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == phone) || isAdmin());
      allow update: if isAdmin();
      // le vendeur retire l'ancien numéro quand il change le sien
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Propositions d'articles : envoyées par un vendeur actif, visibles seulement par lui et par l'admin.
    // L'admin les valide (elles deviennent alors un article dans /items) ou les refuse.
    match /submissions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if canPost()
        && request.resource.data.keys().hasOnly(['title', 'description', 'price', 'category', 'address', 'city', 'currency', 'images', 'ownerId', 'shopName', 'phone', 'status', 'createdAt', 'replaces', 'oldPrice', 'tag', 'country'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.shopName == profile().shopName
        && request.resource.data.phone == profile().phone
        && request.resource.data.status == 'pending'
        && id.matches(request.auth.uid + '_.*')
        && ('replaces' in request.resource.data ? editOk(id) : slotOk(id))
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 100
        && request.resource.data.description is string && request.resource.data.description.size() <= 1500
        && request.resource.data.category is string && request.resource.data.category.size() <= 40
        && request.resource.data.address is string && request.resource.data.address.size() <= 150
        && (!('city' in request.resource.data) || (request.resource.data.city is string && request.resource.data.city.size() <= 40))
        && (!('currency' in request.resource.data) || request.resource.data.currency in currencies())
        && request.resource.data.price is number
        && request.resource.data.price > 0 && request.resource.data.price < 100000000
        && promoOk(request.resource.data) && countryOk(request.resource.data)
        && imgsOk(request.resource.data.images);

      allow update: if isAdmin();
      // le vendeur peut supprimer ses propres articles refusés
      allow delete: if isAdmin() || (signedIn() && siteOpen() && resource.data.ownerId == request.auth.uid && resource.data.status == 'rejected');
    }

    // Articles : lisibles par tous. L'admin en crée (après validation d'une proposition) ; une boutique certifiée peut publier directement.
    match /items/{id} {
      allow read: if true;

      // Admin : après validation d'une proposition. Boutique certifiée par l'admin : publie directement, sans validation.
      allow create: if (isAdmin() && itemShape()
            && (!('certified' in request.resource.data) || request.resource.data.certified is bool))
        || (canPost() && isCertified() && itemShape()
            && id.matches(request.auth.uid + '_.*')
            && request.resource.data.ownerId == request.auth.uid
            && request.resource.data.certified == true
            && request.resource.data.shopName == profile().shopName
            && request.resource.data.phone == profile().phone
            && request.resource.data.shopLogo == (('logo' in profile()) ? profile().logo : '')
            && request.resource.data.get('shopPay', '') == (('payments' in profile()) ? profile().payments : '')
            && request.resource.data.address is string && request.resource.data.address.size() <= 150);

      allow update: if isAdmin()
        || (signedIn() && siteOpen() && resource.data.ownerId == request.auth.uid
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && profile().status == 'active'
            // le vendeur change « disponible / vendu », et recopie sur ses articles les infos de sa boutique (nom, numéro, photo, paiements) ;
            // tout autre changement d'article passe par une proposition validée par l'admin
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'shopName', 'phone', 'shopLogo', 'shopPay'])
            && request.resource.data.status in ['available', 'sold']
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['shopName']) || request.resource.data.shopName == profile().shopName)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone']) || request.resource.data.phone == profile().phone)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['shopLogo']) || request.resource.data.shopLogo == (('logo' in profile()) ? profile().logo : ''))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['shopPay']) || request.resource.data.shopPay == (('payments' in profile()) ? profile().payments : '')));

      allow delete: if isAdmin() || (signedIn() && siteOpen() && resource.data.ownerId == request.auth.uid);
    }

    // Signalements : tout le monde peut en envoyer, seul l'admin les lit
    match /reports/{id} {
      allow create: if siteOpen() && request.resource.data.keys().hasOnly(['itemId', 'reason', 'createdAt'])
        && request.resource.data.itemId is string && request.resource.data.itemId.size() <= 60
        && request.resource.data.reason in ['Arnaque ou faux article', 'Article interdit', 'Prix faux', 'Déjà vendu', 'Autre']
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    // Réglages du site (mode maintenance) : lisibles par tous pour pouvoir bloquer le site, modifiables par l'admin seulement
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Appareils inscrits aux notifications (le jeton sert d'identifiant)
    match /pushTokens/{token} {
      allow create, update: if token.size() >= 100 && token.size() <= 300
        && request.resource.data.keys().hasOnly(['cats', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.cats is list && request.resource.data.cats.size() <= 12;
      allow delete: if true;
      allow read: if false;
    }
  }
}
