rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email == 'joshmukandirwa@gmail.com' && request.auth.token.email_verified == true)
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    // Maintenance : quand l'admin l'active (config/maintenance), plus personne d'autre que lui ne peut écrire.
    function siteOpen() {
      return !(exists(/databases/$(database)/documents/config/maintenance)
        && get(/databases/$(database)/documents/config/maintenance).data.on == true
        && get(/databases/$(database)/documents/config/maintenance).data.until > request.time);
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Un vendeur peut publier s'il n'est pas bloqué, si son numéro est plausible (la confirmation WhatsApp est facultative ; l'email n'est plus exigé : les articles sont publiés sans validation) et son abonnement court encore.
    function canPost() {
      return signedIn() && siteOpen()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().status == 'active'
        && validPhone(profile().phone)
        && profile().activeUntil > request.time;
    }

    // Essai gratuit (plan 'essai') : 2 publications par jour. Les comptes sans champ 'plan' comptent comme essai.
    function isTrial() {
      return !('plan' in profile()) || profile().plan == 'essai';
    }
    // Jour en RDC (UTC+2), au format AAAAMMJJ
    function dayKey() {
      let t = request.time + duration.value(2, 'h');
      return string(t.year()) + (t.month() < 10 ? '0' : '') + string(t.month()) + (t.day() < 10 ? '0' : '') + string(t.day());
    }
    // En essai, une proposition doit porter l'identifiant uid_AAAAMMJJ_1 ou uid_AAAAMMJJ_2 : un identifiant ne sert qu'une fois, donc 2 par jour au maximum.
    function slotOk(id) {
      return !isTrial() || id == request.auth.uid + '_' + dayKey() + '_1' || id == request.auth.uid + '_' + dayKey() + '_2';
    }

    // Photos : uniquement des liens Cloudinary de SokoPlus (1 à 3)
    // Numéro de téléphone plausible : indicatif de pays qui existe, 10 à 15 chiffres, mobile RDC = 243 + 8x/9x + 8 chiffres
    function validPhone(p) {
      return p is string && p.size() >= 10 && p.size() <= 15
        && p.matches('^(1|7|20|27|30|31|32|33|34|36|39|40|41|43|44|45|46|47|48|49|51|52|53|54|55|56|57|58|60|61|62|63|64|65|66|81|82|84|86|90|91|92|93|94|95|98|211|212|213|216|218|220|221|222|223|224|225|226|227|228|229|230|231|232|233|234|235|236|237|238|239|240|241|242|243|244|245|246|247|248|249|250|251|252|253|254|255|256|257|258|260|261|262|263|264|265|266|267|268|269|290|291|297|298|299|350|351|352|353|354|355|356|357|358|359|370|371|372|373|374|375|376|377|378|380|381|382|383|385|386|387|389|420|421|423|500|501|502|503|504|505|506|507|508|509|590|591|592|593|594|595|596|597|598|599|670|672|673|674|675|676|677|678|679|680|681|682|683|685|686|687|688|689|690|691|692|850|852|853|855|856|880|886|960|961|962|963|964|965|966|967|968|970|971|972|973|974|975|976|977|992|993|994|995|996|998)[0-9]*$')
        && (!p.matches('^243.*') || p.matches('^243[89][0-9]{8}$'))
        // longueur du numéro national selon le pays (trop court / trop long = suspect)
        && (!p.matches('^(248|269|291|220|238|239|267|230|241|961|265|264|252|231|245|257|268|266|253|216|222|236|235|228|226|223|227|232|213|237|234|225|229|243|250|256|254|255|242|244|260|258|261|251|211|249|212|221|971|233|224|240|351|966|263|218|32|27|33|34|41|31|20|39|44|91|90|49|86|1|7)[0-9]*$') || p.matches('^((248|269|291|220|238|239)[0-9]{7}|(267|230|241|961)[0-9]{7,8}|(265|264|252|231|245)[0-9]{7,9}|(257|268|266|253|216|222|236|235|228|226|223|227|232)[0-9]{8}|(213|32|237)[0-9]{8,9}|(234|225|229)[0-9]{8,10}|(243|250|256|254|255|242|244|260|258|27|261|251|211|249|212|221|33|971|233|224|240|34|351|41|31|966)[0-9]{9}|(263|20|218)[0-9]{9,10}|(39)[0-9]{9,11}|(1|44|91|90|7)[0-9]{10}|(49)[0-9]{10,12}|(86)[0-9]{11})$'));
    }
    function imgUrl(u) { return u is string && u.size() <= 300 && u.matches('https://res[.]cloudinary[.]com/dqtu9carq/.*'); }
    function imgsOk(l) {
      return l is list && l.size() >= 1 && l.size() <= 3 && imgUrl(l[0])
        && (l.size() < 2 || imgUrl(l[1])) && (l.size() < 3 || imgUrl(l[2]));
    }
    // Proposition de modification d'un article existant : un seul identifiant possible par article (uid_edit_idArticle), et l'article doit être à soi
    function editOk(id) {
      let r = request.resource.data.replaces;
      return r is string && r.size() <= 60 && id == request.auth.uid + '_edit_' + r
        && exists(/databases/$(database)/documents/items/$(r))
        && get(/databases/$(database)/documents/items/$(r)).data.ownerId == request.auth.uid;
    }

    // Monnaies acceptées : celles des pays d'Afrique, le dollar et l'euro (FC = franc congolais)
    function currencies() {
      return ['USD', 'EUR', 'FC', 'RWF', 'BIF', 'UGX', 'KES', 'TZS', 'XAF', 'XOF', 'AOA', 'ZMW', 'ZWL', 'MZN', 'MWK', 'ZAR', 'NAD', 'BWP', 'SZL', 'LSL', 'MGA', 'MUR', 'SCR', 'KMF', 'ETB', 'ERN', 'DJF', 'SOS', 'SSP', 'SDG', 'EGP', 'LYD', 'TND', 'DZD', 'MAD', 'MRU', 'GMD', 'GNF', 'SLE', 'LRD', 'GHS', 'NGN', 'STN', 'CVE'];
    }
    function meetOk(d) { return (!('meetPlace' in d) || (d.meetPlace is string && d.meetPlace.size() <= 80)) && (!('delivery' in d) || d.delivery is bool) && (!('swapFor' in d) || (d.swapFor is string && d.swapFor.size() <= 80))
      && (!('voice' in d) || (d.voice is string && d.voice.size() <= 300 && d.voice.matches('https://res[.]cloudinary[.]com/dqtu9carq/video/upload/.*')))
      && (!('voiceSec' in d) || (d.voiceSec is int && d.voiceSec >= 1 && d.voiceSec <= 60)); }
    // Achat groupé facultatif : prix de groupe plus bas que le prix, minimum de personnes, durée
    function groupOk(d) {
      return (!('groupPrice' in d) && !('groupMin' in d) && !('groupDays' in d))
        || ('groupPrice' in d && 'groupMin' in d && 'groupDays' in d
            && d.groupPrice is number && d.groupPrice > 0 && d.groupPrice < d.price
            && d.groupMin is int && d.groupMin >= 2 && d.groupMin <= 50
            && d.groupDays is int && d.groupDays in [3, 7, 14]);
    }
    function countryOk(d) { return !('country' in d) || (d.country is string && d.country.size() == 2); }
    // Promotion choisie par le vendeur : ancien prix (facultatif, plus haut que le prix) et type d'annonce (facultatif)
    function promoOk(d) {
      return (!('oldPrice' in d) || (d.oldPrice is number && d.oldPrice > d.price && d.oldPrice < 100000000))
        && (!('tag' in d) || d.tag in ['promo', 'offre']);
    }
    function isCertified() {
      return ('certified' in profile()) && profile().certified == true;
    }
    // Forme d'un article en ligne (admin, ou boutique certifiée qui publie directement)
    function itemShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'description', 'price', 'category', 'address', 'city', 'currency', 'images', 'ownerId', 'shopName', 'phone', 'shopLogo', 'shopPay', 'status', 'featured', 'createdAt', 'certified', 'oldPrice', 'tag', 'country', 'negotiable', 'meetPlace', 'swapFor', 'voice', 'voiceSec', 'groupPrice', 'groupMin', 'groupDays', 'delivery'])
        && d.ownerId is string
        && d.status == 'available'
        && d.featured == false
        && d.createdAt == request.time
        && d.title is string && d.title.size() >= 2 && d.title.size() <= 100
        && d.description is string && d.description.size() <= 1500
        && d.price is number && d.price > 0 && d.price < 100000000
        && (!('city' in d) || (d.city is string && d.city.size() <= 40))
        && (!('shopPay' in d) || (d.shopPay is string && d.shopPay.size() <= 120))
        && (!('currency' in d) || d.currency in currencies())
        && promoOk(d) && countryOk(d) && (!('negotiable' in d) || d.negotiable is bool) && meetOk(d) && groupOk(d)
        && imgsOk(d.images);
    }

    // Modification d'un article par son vendeur (appliquée tout de suite)
    function editedOk() {
      let d = request.resource.data;
      return d.title is string && d.title.size() >= 2 && d.title.size() <= 100
        && d.description is string && d.description.size() <= 1500
        && d.category is string && d.category.size() <= 40
        && d.address is string && d.address.size() <= 150
        && d.price is number && d.price > 0 && d.price < 100000000
        && (!('city' in d) || (d.city is string && d.city.size() <= 40))
        && (!('currency' in d) || d.currency in currencies())
        && promoOk(d) && countryOk(d) && (!('negotiable' in d) || d.negotiable is bool) && meetOk(d) && groupOk(d) && imgsOk(d.images);
    }

    // Places de publication de l'essai gratuit : une place par jour et par numéro (uid_AAAAMMJJ_1 ou _2), créée en même temps que l'article. On ne peut ni la supprimer ni la recréer.
    match /postSlots/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if canPost() && isTrial() && slotOk(id)
        && request.resource.data.keys().hasOnly(['ownerId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
    }

    // Administrateurs : documents créés à la main dans la console (README, étape 7)
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // Compte acheteur : prénom affiché avec les avis. Chacun lit et modifie seulement le sien.
    match /buyers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && siteOpen() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && siteOpen() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40;
      allow delete: if isAdmin();
    }

    // Avis clients : un par personne et par article (identifiant = uid_article). Visibles seulement après validation par l'admin.
    function reviewShape(d) {
      return d.keys().hasOnly(['itemId', 'shopId', 'buyerId', 'buyerName', 'buyerLogo', 'stars', 'text', 'status', 'createdAt'])
        && (!('buyerLogo' in d) || (d.buyerLogo is string && d.buyerLogo.size() <= 300 && d.buyerLogo.matches('https://.*')))
        && d.itemId is string && d.stars is int && d.stars >= 1 && d.stars <= 5
        && d.text is string && d.text.size() <= 300
        && d.buyerName is string && d.buyerName.size() >= 2 && d.buyerName.size() <= 40
        && d.status == 'pending';
    }
    match /reviews/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin() || (signedIn() && resource.data.buyerId == request.auth.uid);
      allow create: if signedIn() && siteOpen() && reviewShape(request.resource.data)
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.shopId is string && request.resource.data.shopId != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.itemId
        && exists(/databases/$(database)/documents/items/$(request.resource.data.itemId))
        && get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.ownerId == request.resource.data.shopId
        && exists(/databases/$(database)/documents/buyers/$(request.auth.uid))
        && get(/databases/$(database)/documents/buyers/$(request.auth.uid)).data.name == request.resource.data.buyerName
        && request.resource.data.createdAt == request.time;
      // l'acheteur peut modifier son avis : il repasse en « à valider »
      allow update: if isAdmin()
        || (signedIn() && siteOpen() && resource.data.buyerId == request.auth.uid && reviewShape(request.resource.data)
            && request.resource.data.buyerId == resource.data.buyerId && request.resource.data.shopId == resource.data.shopId && request.resource.data.itemId == resource.data.itemId
            && request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isAdmin() || (signedIn() && resource.data.buyerId == request.auth.uid);
    }

    // « Avis utile » : un vote par personne et par avis (identifiant = uid_avis). Lisibles par tous pour afficher le total ; chacun ne retire que le sien.
    match /reviewVotes/{id} {
      allow read: if true;
      allow create: if signedIn() && siteOpen()
        && request.resource.data.keys().hasOnly(['reviewId', 'shopId', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reviewId is string && request.resource.data.shopId is string
        && id == request.auth.uid + '_' + request.resource.data.reviewId
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/reviews/$(request.resource.data.reviewId))
        && get(/databases/$(database)/documents/reviews/$(request.resource.data.reviewId)).data.status == 'approved'
        && get(/databases/$(database)/documents/reviews/$(request.resource.data.reviewId)).data.shopId == request.resource.data.shopId
        && get(/databases/$(database)/documents/reviews/$(request.resource.data.reviewId)).data.buyerId != request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Profil vendeur
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && siteOpen() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['shopName', 'phone', 'email', 'status', 'plan', 'activeUntil', 'createdAt'])
        && request.resource.data.shopName is string
        && request.resource.data.shopName.size() >= 2 && request.resource.data.shopName.size() <= 60
        && validPhone(request.resource.data.phone)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'active'
        && request.resource.data.plan == 'essai'
        && request.resource.data.createdAt == request.time
        // essai gratuit : environ 30 jours, pas plus
        && request.resource.data.activeUntil > request.time + duration.value(28, 'd')
        && request.resource.data.activeUntil < request.time + duration.value(32, 'd');
      // Nom, numéro, photo de profil et modes de paiement : le vendeur les modifie lui-même, sans validation de l'admin
      allow update: if isAdmin()
        || (signedIn() && siteOpen() && request.auth.uid == uid
            && resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shopName', 'phone', 'logo', 'payments', 'phoneVerified'])
            && request.resource.data.shopName is string
            && request.resource.data.shopName.size() >= 2 && request.resource.data.shopName.size() <= 60
            && validPhone(request.resource.data.phone)
            // « numéro confirmé » : seul l'admin peut le mettre à vrai ; le vendeur peut seulement le retirer, et il tombe dès que le numéro change
            && request.resource.data.get('phoneVerified', false) in [resource.data.get('phoneVerified', false), false]
            && (request.resource.data.phone == resource.data.phone || request.resource.data.get('phoneVerified', false) == false)
            && (!('logo' in request.resource.data) || imgUrl(request.resource.data.logo))
            && (!('payments' in request.resource.data) || (request.resource.data.payments is string && request.resource.data.payments.size() <= 120)));
    }

    // Profil public de la boutique (couverture, à propos, coordonnées, liens) : lisible par tous, modifié par le vendeur lui-même, sans validation
    function linkOk(u) { return u is string && u.size() <= 200 && u.matches('https?://.*'); }
    match /shops/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && siteOpen() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().status == 'active'
        && request.resource.data.keys().hasOnly(['cover', 'about', 'address', 'email', 'website', 'facebook', 'instagram', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (!('cover' in request.resource.data) || imgUrl(request.resource.data.cover))
        && (!('about' in request.resource.data) || (request.resource.data.about is string && request.resource.data.about.size() <= 300))
        && (!('address' in request.resource.data) || (request.resource.data.address is string && request.resource.data.address.size() <= 150))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 100 && request.resource.data.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')))
        && (!('website' in request.resource.data) || linkOk(request.resource.data.website))
        && (!('facebook' in request.resource.data) || linkOk(request.resource.data.facebook))
        && (!('instagram' in request.resource.data) || linkOk(request.resource.data.instagram));
      allow delete: if isAdmin();
    }

    // Demandes de modification de boutique (nom, numéro, photo de profil) : une par boutique, validée ou refusée par l'admin
    match /profileRequests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && siteOpen() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['shopName', 'phone', 'logo', 'payments', 'status', 'createdAt'])
        && request.resource.data.keys().hasAny(['shopName', 'phone', 'logo', 'payments'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && (!('shopName' in request.resource.data) || (request.resource.data.shopName is string && request.resource.data.shopName.size() >= 2 && request.resource.data.shopName.size() <= 60))
        && (!('phone' in request.resource.data) || validPhone(request.resource.data.phone))
        && (!('payments' in request.resource.data) || (request.resource.data.payments is string && request.resource.data.payments.size() <= 120))
        && (!('logo' in request.resource.data) || (request.resource.data.logo is string && request.resource.data.logo.matches('https://.*') && request.resource.data.logo.size() <= 300));
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid && resource.data.status == 'rejected');
    }

    // Demandes de certification : une par boutique. Le vendeur la crée (en attente), l'admin l'approuve (la demande disparaît) ou la refuse (avec motif)
    match /certRequests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && siteOpen() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('certified', false) != true
        && request.resource.data.keys().hasOnly(['status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid && resource.data.status == 'rejected');
    }

    // Messages de SokoPlus à un vendeur (certification approuvée ou refusée...). Écrits par l'admin ; le vendeur les lit et les marque comme lus.
    match /userNotifs/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin();
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Numéro -> email, pour se connecter avec le téléphone (lecture d'un seul document à la fois, pas de liste)
    match /phoneIndex/{phone} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && (siteOpen() || isAdmin())
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && ((request.resource.data.uid == request.auth.uid && request.resource.data.email == request.auth.token.email
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == phone) || isAdmin());
      allow update: if isAdmin();
      // le vendeur retire l'ancien numéro quand il change le sien
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Achats groupés : un groupe par article (groups/{idArticle}), les participants dans groups/{idArticle}/members/{uid}.
    // Le compteur ne bouge que de 1 à la fois, avec l'arrivée ou le départ du participant dans la même écriture. Le vendeur seul voit les numéros WhatsApp.
    match /groups/{itemId} {
      allow read: if true;
      allow create: if signedIn() && siteOpen()
        && request.resource.data.keys().hasOnly(['itemId', 'ownerId', 'count', 'min', 'startedAt', 'endsAt'])
        && request.resource.data.itemId == itemId
        && request.resource.data.ownerId == get(/databases/$(database)/documents/items/$(itemId)).data.ownerId
        && request.resource.data.ownerId != request.auth.uid
        && request.resource.data.min == get(/databases/$(database)/documents/items/$(itemId)).data.groupMin
        && request.resource.data.count == 1
        && request.resource.data.startedAt == request.time
        && request.resource.data.endsAt > request.time + duration.value(get(/databases/$(database)/documents/items/$(itemId)).data.groupDays, 'd') - duration.value(12, 'h')
        && request.resource.data.endsAt < request.time + duration.value(get(/databases/$(database)/documents/items/$(itemId)).data.groupDays, 'd') + duration.value(12, 'h')
        && existsAfter(/databases/$(database)/documents/groups/$(itemId)/members/$(request.auth.uid));
      allow update: if signedIn() && siteOpen()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && ((request.resource.data.count == resource.data.count + 1 && request.resource.data.count <= 200
              && resource.data.endsAt > request.time && resource.data.ownerId != request.auth.uid
              && !exists(/databases/$(database)/documents/groups/$(itemId)/members/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/groups/$(itemId)/members/$(request.auth.uid)))
            || (request.resource.data.count == resource.data.count - 1 && request.resource.data.count >= 0
              && exists(/databases/$(database)/documents/groups/$(itemId)/members/$(request.auth.uid))
              && !existsAfter(/databases/$(database)/documents/groups/$(itemId)/members/$(request.auth.uid))));
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);

      match /members/{uid} {
        allow read: if isAdmin() || (signedIn() && (uid == request.auth.uid || resource.data.ownerId == request.auth.uid));
        allow create: if signedIn() && siteOpen() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'ownerId', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.ownerId == getAfter(/databases/$(database)/documents/groups/$(itemId)).data.ownerId
          && getAfter(/databases/$(database)/documents/groups/$(itemId)).data.endsAt > request.time
          && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
          && validPhone(request.resource.data.phone)
          && request.resource.data.createdAt == request.time;
        allow delete: if isAdmin() || (signedIn() && (uid == request.auth.uid || resource.data.ownerId == request.auth.uid));
      }
    }

    // « Je cherche… » : un acheteur (ou un vendeur) publie ce qu'il veut acheter, les vendeurs lui répondent sur WhatsApp. Publié tout de suite ; 3 demandes par jour au maximum (identifiant uid_AAAAMMJJ_1 à _3, jamais réutilisable car seul l'admin peut supprimer).
    match /wants/{id} {
      allow read: if true;
      allow create: if signedIn() && siteOpen()
        && request.resource.data.keys().hasOnly(['title', 'details', 'category', 'budget', 'currency', 'city', 'country', 'name', 'phone', 'avatar', 'ownerId', 'status', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && id in [request.auth.uid + '_' + dayKey() + '_1', request.auth.uid + '_' + dayKey() + '_2', request.auth.uid + '_' + dayKey() + '_3']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 80
        && (!('details' in request.resource.data) || (request.resource.data.details is string && request.resource.data.details.size() <= 300))
        && request.resource.data.category is string && request.resource.data.category.size() <= 40
        && (!('budget' in request.resource.data) || (request.resource.data.budget is number && request.resource.data.budget > 0 && request.resource.data.budget < 100000000))
        && (!('currency' in request.resource.data) || request.resource.data.currency in currencies())
        && (!('city' in request.resource.data) || (request.resource.data.city is string && request.resource.data.city.size() <= 40))
        && countryOk(request.resource.data)
        && (!('avatar' in request.resource.data) || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 400 && request.resource.data.avatar.matches('https://.*')))
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
        && validPhone(request.resource.data.phone);
      // le demandeur clôt sa demande (« trouvé »), la réactive si c'était une erreur, ou la supprime (« deleted » : invisible pour tous, définitif).
      // Le document reste en base pour que son identifiant du jour ne soit pas réutilisable (limite de 3 demandes par jour) ; l'admin peut tout modifier
      allow update: if isAdmin()
        || (signedIn() && siteOpen() && resource.data.ownerId == request.auth.uid
            && resource.data.status != 'deleted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['found', 'open', 'deleted']);
      allow delete: if isAdmin();
    }

    // Propositions d'articles : envoyées par un vendeur actif, visibles seulement par lui et par l'admin.
    // L'admin les valide (elles deviennent alors un article dans /items) ou les refuse.
    match /submissions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if canPost()
        && request.resource.data.keys().hasOnly(['title', 'description', 'price', 'category', 'address', 'city', 'currency', 'images', 'ownerId', 'shopName', 'phone', 'status', 'createdAt', 'replaces', 'oldPrice', 'tag', 'country'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.shopName == profile().shopName
        && request.resource.data.phone == profile().phone
        && request.resource.data.status == 'pending'
        && id.matches(request.auth.uid + '_.*')
        && ('replaces' in request.resource.data ? editOk(id) : slotOk(id))
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 100
        && request.resource.data.description is string && request.resource.data.description.size() <= 1500
        && request.resource.data.category is string && request.resource.data.category.size() <= 40
        && request.resource.data.address is string && request.resource.data.address.size() <= 150
        && (!('city' in request.resource.data) || (request.resource.data.city is string && request.resource.data.city.size() <= 40))
        && (!('currency' in request.resource.data) || request.resource.data.currency in currencies())
        && request.resource.data.price is number
        && request.resource.data.price > 0 && request.resource.data.price < 100000000
        && promoOk(request.resource.data) && countryOk(request.resource.data)
        && imgsOk(request.resource.data.images);

      allow update: if isAdmin();
      // le vendeur peut supprimer ses propres articles refusés
      allow delete: if isAdmin() || (signedIn() && siteOpen() && resource.data.ownerId == request.auth.uid && resource.data.status == 'rejected');
    }

    // Articles : lisibles par tous. L'admin en crée (après validation d'une proposition) ; une boutique certifiée peut publier directement.
    match /items/{id} {
      allow read: if true;

      // Admin, ou n'importe quel vendeur actif : l'article est en ligne tout de suite, sans validation. L'admin peut le supprimer ensuite (avec un motif envoyé au vendeur).
      allow create: if (isAdmin() && itemShape()
            && (!('certified' in request.resource.data) || request.resource.data.certified is bool))
        || (canPost() && itemShape()
            && id.matches(request.auth.uid + '_.*')
            && request.resource.data.ownerId == request.auth.uid
            && request.resource.data.certified == isCertified()
            // essai gratuit : 2 publications par jour. L'article porte l'identifiant d'une place du jour, créée dans la même écriture (postSlots) et jamais réutilisable.
            && (isCertified() || !isTrial()
                || (slotOk(id)
                    && !exists(/databases/$(database)/documents/postSlots/$(id))
                    && existsAfter(/databases/$(database)/documents/postSlots/$(id))))
            && request.resource.data.shopName == profile().shopName
            && request.resource.data.phone == profile().phone
            && request.resource.data.shopLogo == (('logo' in profile()) ? profile().logo : '')
            && request.resource.data.get('shopPay', '') == (('payments' in profile()) ? profile().payments : '')
            && request.resource.data.address is string && request.resource.data.address.size() <= 150);

      allow update: if isAdmin()
        || (signedIn() && siteOpen() && resource.data.ownerId == request.auth.uid
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && profile().status == 'active'
            // le vendeur change « disponible / vendu », et recopie sur ses articles les infos de sa boutique (nom, numéro, photo, paiements) ;
            // tout autre changement d'article passe par une proposition validée par l'admin
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'shopName', 'phone', 'shopLogo', 'shopPay', 'title', 'description', 'price', 'category', 'address', 'city', 'currency', 'images', 'oldPrice', 'tag', 'country', 'negotiable', 'meetPlace', 'swapFor', 'voice', 'voiceSec', 'groupPrice', 'groupMin', 'groupDays', 'delivery'])
            && request.resource.data.status in ['available', 'sold']
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['shopName']) || request.resource.data.shopName == profile().shopName)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone']) || request.resource.data.phone == profile().phone)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['shopLogo']) || request.resource.data.shopLogo == (('logo' in profile()) ? profile().logo : ''))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['shopPay']) || request.resource.data.shopPay == (('payments' in profile()) ? profile().payments : ''))
            // le vendeur modifie lui-même son article : les nouvelles valeurs respectent les mêmes limites qu'à la publication
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'description', 'price', 'category', 'address', 'city', 'currency', 'images', 'oldPrice', 'tag', 'country', 'negotiable', 'meetPlace', 'swapFor', 'voice', 'voiceSec', 'groupPrice', 'groupMin', 'groupDays', 'delivery']) || editedOk()));

      allow delete: if isAdmin() || (signedIn() && siteOpen() && resource.data.ownerId == request.auth.uid);
    }

    // Annonces officielles : tout le monde les lit ; seul l'admin les publie et les supprime.
    // N'importe quel visiteur peut seulement ajouter exactement +1 au compteur de vues.
    match /announcements/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['kind', 'title', 'text', 'images', 'views', 'createdAt', 'expiresAt'])
        && request.resource.data.kind in ['annonce', 'communique', 'important']
        && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 100
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.images is list && request.resource.data.images.size() <= 4
        && (request.resource.data.images.size() == 0 || imgUrl(request.resource.data.images[0]))
        && (request.resource.data.images.size() < 2 || imgUrl(request.resource.data.images[1]))
        && (request.resource.data.images.size() < 3 || imgUrl(request.resource.data.images[2]))
        && (request.resource.data.images.size() < 4 || imgUrl(request.resource.data.images[3]))
        && request.resource.data.views == 0
        && request.resource.data.createdAt == request.time
        && (!('expiresAt' in request.resource.data) || request.resource.data.expiresAt is timestamp);
      allow update: if isAdmin()
        || (siteOpen() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
            && request.resource.data.views == resource.data.get('views', 0) + 1);
      allow delete: if isAdmin();
    }

    // Vues d'un article : un seul champ « n », qui ne peut monter que de 1 à la fois
    match /itemViews/{id} {
      allow read: if true;
      allow create: if siteOpen() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1
        && exists(/databases/$(database)/documents/items/$(id));
      allow update: if siteOpen() && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
      allow delete: if isAdmin();
    }

    // Signalements : tout le monde peut en envoyer, seul l'admin les lit
    match /reports/{id} {
      allow create: if siteOpen() && request.resource.data.keys().hasOnly(['itemId', 'reason', 'createdAt'])
        && request.resource.data.itemId is string && request.resource.data.itemId.size() <= 60
        && request.resource.data.reason in ['Arnaque ou faux article', 'Article interdit', 'Prix faux', 'Déjà vendu', 'Autre']
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    // Réglages du site (mode maintenance) : lisibles par tous pour pouvoir bloquer le site, modifiables par l'admin seulement
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Abonnements aux boutiques : écrits uniquement par le serveur (api/follow.js). Chacun ne lit que les siens.
    match /follows/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    // Nombre d'abonnés par boutique : public en lecture, écrit uniquement par le serveur
    match /shopStats/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Appareils inscrits aux notifications (le jeton sert d'identifiant)
    match /pushTokens/{token} {
      allow create, update: if token.size() >= 100 && token.size() <= 300
        && request.resource.data.keys().hasOnly(['cats', 'updatedAt', 'uid', 'country', 'city'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.cats is list && request.resource.data.cats.size() <= 12
        && (!('country' in request.resource.data) || (request.resource.data.country is string && request.resource.data.country.size() <= 6))
        && (!('city' in request.resource.data) || (request.resource.data.city is string && request.resource.data.city.size() <= 40))
        && (!('uid' in request.resource.data) || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow delete: if true;
      allow read: if false;
    }
  }
}
