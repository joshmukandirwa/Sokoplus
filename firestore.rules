rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email == 'joshmukandirwa@gmail.com' && request.auth.token.email_verified == true)
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Un vendeur peut publier s'il a vérifié son email, n'est pas bloqué et son abonnement court encore.
    function canPost() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().status == 'active'
        && profile().activeUntil > request.time;
    }

    // Essai gratuit (plan 'essai') : 2 publications par jour. Les comptes sans champ 'plan' comptent comme essai.
    function isTrial() {
      return !('plan' in profile()) || profile().plan == 'essai';
    }
    // Jour en RDC (UTC+2), au format AAAAMMJJ
    function dayKey() {
      let t = request.time + duration.value(2, 'h');
      return string(t.year()) + (t.month() < 10 ? '0' : '') + string(t.month()) + (t.day() < 10 ? '0' : '') + string(t.day());
    }
    // En essai, une proposition doit porter l'identifiant uid_AAAAMMJJ_1 ou uid_AAAAMMJJ_2 : un identifiant ne sert qu'une fois, donc 2 par jour au maximum.
    function slotOk(id) {
      return !isTrial() || id == request.auth.uid + '_' + dayKey() + '_1' || id == request.auth.uid + '_' + dayKey() + '_2';
    }

    // Administrateurs : documents créés à la main dans la console (README, étape 7)
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // Profil vendeur
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['shopName', 'phone', 'email', 'status', 'plan', 'activeUntil', 'createdAt'])
        && request.resource.data.shopName is string
        && request.resource.data.shopName.size() >= 2 && request.resource.data.shopName.size() <= 60
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10 && request.resource.data.phone.size() <= 15
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'active'
        && request.resource.data.plan == 'essai'
        && request.resource.data.createdAt == request.time
        // essai gratuit : environ 30 jours, pas plus
        && request.resource.data.activeUntil > request.time + duration.value(28, 'd')
        && request.resource.data.activeUntil < request.time + duration.value(32, 'd');
      // nom, numéro et photo ne changent plus directement : le vendeur envoie une demande (profileRequests), l'admin la valide
      allow update: if isAdmin();
    }

    // Demandes de modification de boutique (nom, numéro, photo de profil) : une par boutique, validée ou refusée par l'admin
    match /profileRequests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['shopName', 'phone', 'logo', 'status', 'createdAt'])
        && request.resource.data.keys().hasAny(['shopName', 'phone', 'logo'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && (!('shopName' in request.resource.data) || (request.resource.data.shopName is string && request.resource.data.shopName.size() >= 2 && request.resource.data.shopName.size() <= 60))
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() >= 10 && request.resource.data.phone.size() <= 15))
        && (!('logo' in request.resource.data) || (request.resource.data.logo is string && request.resource.data.logo.matches('https://.*') && request.resource.data.logo.size() <= 300));
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid && resource.data.status == 'rejected');
    }

    // Numéro -> email, pour se connecter avec le téléphone (lecture d'un seul document à la fois, pas de liste)
    match /phoneIndex/{phone} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && ((request.resource.data.uid == request.auth.uid && request.resource.data.email == request.auth.token.email) || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Propositions d'articles : envoyées par un vendeur actif, visibles seulement par lui et par l'admin.
    // L'admin les valide (elles deviennent alors un article dans /items) ou les refuse.
    match /submissions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if canPost()
        && request.resource.data.keys().hasOnly(['title', 'description', 'price', 'category', 'address', 'city', 'currency', 'images', 'ownerId', 'shopName', 'phone', 'status', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.shopName == profile().shopName
        && request.resource.data.phone == profile().phone
        && request.resource.data.status == 'pending'
        && slotOk(id)
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 100
        && request.resource.data.description is string && request.resource.data.description.size() <= 1500
        && request.resource.data.category is string && request.resource.data.category.size() <= 40
        && request.resource.data.address is string && request.resource.data.address.size() <= 150
        && (!('city' in request.resource.data) || (request.resource.data.city is string && request.resource.data.city.size() <= 40))
        && (!('currency' in request.resource.data) || request.resource.data.currency in ['USD', 'FC'])
        && request.resource.data.price is number
        && request.resource.data.price > 0 && request.resource.data.price < 100000000
        && request.resource.data.images is list
        && request.resource.data.images.size() >= 1 && request.resource.data.images.size() <= 3;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Articles : lisibles par tous. Seul l'admin en crée (après validation d'une proposition).
    match /items/{id} {
      allow read: if true;

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'description', 'price', 'category', 'address', 'city', 'currency', 'images', 'ownerId', 'shopName', 'phone', 'shopLogo', 'status', 'featured', 'createdAt'])
        && request.resource.data.ownerId is string
        && request.resource.data.status == 'available'
        && request.resource.data.featured == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.price is number && request.resource.data.price > 0
        && (!('city' in request.resource.data) || (request.resource.data.city is string && request.resource.data.city.size() <= 40))
        && (!('currency' in request.resource.data) || request.resource.data.currency in ['USD', 'FC'])
        && request.resource.data.images is list
        && request.resource.data.images.size() >= 1 && request.resource.data.images.size() <= 3;

      allow update: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'price', 'category', 'address', 'city', 'currency', 'images', 'status'])
            && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 100
            && request.resource.data.description.size() <= 1500
            && request.resource.data.price is number && request.resource.data.price > 0
            && request.resource.data.images.size() >= 1 && request.resource.data.images.size() <= 3
            && (!('city' in request.resource.data) || (request.resource.data.city is string && request.resource.data.city.size() <= 40))
        && (!('currency' in request.resource.data) || request.resource.data.currency in ['USD', 'FC'])
            && request.resource.data.status in ['available', 'sold']);

      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Signalements : tout le monde peut en envoyer, seul l'admin les lit
    match /reports/{id} {
      allow create: if request.resource.data.keys().hasOnly(['itemId', 'reason', 'createdAt'])
        && request.resource.data.itemId is string && request.resource.data.itemId.size() <= 60
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    // Appareils inscrits aux notifications (le jeton sert d'identifiant)
    match /pushTokens/{token} {
      allow create, update: if request.resource.data.keys().hasOnly(['cats', 'updatedAt'])
        && request.resource.data.cats is list && request.resource.data.cats.size() <= 12;
      allow delete: if true;
      allow read: if false;
    }
  }
}
